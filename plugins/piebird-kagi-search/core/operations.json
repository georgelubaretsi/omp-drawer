    "search": {
      "input": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "time": {
            "type": "string",
            "enum": [
              "day",
              "week",
              "month",
              "year"
            ]
          },
          "from_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "to_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "format": {
            "type": "string",
            "enum": [
              "markdown",
              "json"
            ]
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "snippet": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                }
              },
              "required": [
                "title",
                "url"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "results"
        ],
        "additionalProperties": false
      },
      "errors": [
        "bad-input",
        "failed",
        "vault",
        "one-of",
        "empty-query",
        "limit",
        "time-and-dates",
        "date",
        "dates-order",
        "sign-in-needed",
        "env-session-refused",
        "secret-store",
        "http-status",
        "cannot-reach",
        "reading"
      ],
      "vault": true,
      "tool": {
        "name": "kagi_search",
        "readOnly": true,
        "openWorld": true,
        "alwaysLoad": true
      }
    },
