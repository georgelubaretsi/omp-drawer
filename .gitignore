node_modules/
result
.DS_Store

# Native programs, built by tools/native.ts (docs/manifests.md, "Native programs")
/plugins/*/native/

# Upstream git clones and sync staging, refreshed by tools/sync-references.ts
/reference/tern-sdk/
/reference/omp/
/reference/mcp/
/reference/.staging-*/

# Declarations Claude Code writes into a mod's plugin when `claude --plugin-dir` loads it
/plugins/*/.claude-plugin/types/

# A vault built in place by `go build ./cmd/<program>`
/kagi-vault

# Installers and release archives, built by tools/installer.ts and tools/release.ts
/dist/
