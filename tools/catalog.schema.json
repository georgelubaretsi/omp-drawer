{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "omp-drawer catalog.json",
  "description": "The hand-written plugin list tools/build.ts turns into the omp, Claude Code and Codex marketplace files. Uniqueness of entry names and the match between entries and plugins/<name>/ are checked in tools/build.ts.",
  "type": "object",
  "properties": {
    "name": {
      "$ref": "#/$defs/name"
    },
    "owner": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/text"
        },
        "email": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "description": {
      "$ref": "#/$defs/text"
    },
    "plugins": {
      "description": "Output order of the marketplace entries.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/name"
          },
          "category": {
            "$ref": "#/$defs/text"
          },
          "hosts": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["omp", "claude", "codex"]
            }
          }
        },
        "required": ["name", "category", "hosts"],
        "additionalProperties": false
      }
    }
  },
  "required": ["name", "owner", "description", "plugins"],
  "additionalProperties": false,
  "$defs": {
    "name": {
      "description": "A name omp, Claude Code and Codex all accept: kebab-case, at most 64 characters, without \"claude\" or \"anthropic\". Also applied to plugin.json name.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?!.*(?:claude|anthropic))[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "text": {
      "type": "string",
      "pattern": "\\S"
    }
  }
}
