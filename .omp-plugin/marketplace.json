  },
  "metadata": {
    "description": "Plugins for omp, Claude Code, Codex and the Tern terminal"
  },
  "plugins": [
    {
      "name": "piebird-kagi-search",
      "source": "./plugins/piebird-kagi-search",
      "version": "0.1.0",
      "description": "Kagi web search for coding agents, with your own Kagi account",
      "author": {
        "name": "George Lubaretsi",
        "email": "george@lubaretsi.com"
      },
      "homepage": "https://github.com/georgelubaretsi/piebird/tree/main/plugins/piebird-kagi-search",
      "repository": "https://github.com/georgelubaretsi/piebird",
      "license": "MIT",
      "keywords": [
        "kagi",
        "search",
        "mcp"
      ],
      "category": "search"
    },
    {
      "name": "piebird-agent-variants",
      "source": "./plugins/piebird-agent-variants",
      "version": "0.1.0",
      "description": "Create temporary project-scoped agent variants with explicit model routing",
      "author": {
        "name": "George Lubaretsi",
        "email": "george@lubaretsi.com"
      },
      "homepage": "https://github.com/georgelubaretsi/piebird/tree/main/plugins/piebird-agent-variants",
      "repository": "https://github.com/georgelubaretsi/piebird",
      "license": "MIT",
      "keywords": [
        "agents",
        "models",
        "omp"
      ],
      "category": "development"
    },
    {
      "name": "piebird-sessions",
      "source": "./plugins/piebird-sessions",
      "version": "0.1.0",
      "description": "Read coding agents' session journals (omp, Claude Code, Codex): a session_read tool that reads, pages and searches a session by id and line, with asks shown in full, and the agent told its own session id",
      "author": {
        "name": "George Lubaretsi",
        "email": "george@lubaretsi.com"
      },
      "homepage": "https://github.com/georgelubaretsi/piebird/tree/main/plugins/piebird-sessions",
      "repository": "https://github.com/georgelubaretsi/piebird",
      "license": "MIT",
      "keywords": [
        "omp",
        "claude-code",
        "codex",
        "sessions",
        "journal"
      ],
      "category": "development"
    },
    {
      "name": "piebird-tern-bridge",
      "source": "./plugins/piebird-tern-bridge",
      "version": "0.1.0",
      "description": "Use Tern from omp: a tern_lua tool running Lua with Tern's window API (agents, layout, blocks, git, settings) and a tern skill",
      "author": {
        "name": "George Lubaretsi",
        "email": "george@lubaretsi.com"
      },
      "homepage": "https://github.com/georgelubaretsi/piebird/tree/main/plugins/piebird-tern-bridge",
      "repository": "https://github.com/georgelubaretsi/piebird",
      "license": "MIT",
      "keywords": [
        "tern",
        "terminal",
        "omp"
      ],
      "category": "development"
    },
    {
      "name": "piebird-threads",
      "source": "./plugins/piebird-threads",
      "version": "0.1.0",
      "description": "Open threads in front of omp's agent: the project's open lines of work, in the folder its .omp/threads.json names, listed before a prompt whenever the list changes; a rule and skill on writing them",
      "author": {
        "name": "George Lubaretsi",
        "email": "george@lubaretsi.com"
      },
      "homepage": "https://github.com/georgelubaretsi/piebird/tree/main/plugins/piebird-threads",
      "repository": "https://github.com/georgelubaretsi/piebird",
      "license": "MIT",
      "keywords": [
        "omp",
        "threads",
        "work in progress"
      ],
      "category": "productivity"
    },
    {
      "name": "piebird-workflow-rules",
      "source": "./plugins/piebird-workflow-rules",
      "version": "0.1.0",
      "description": "How to work: weigh problems in proportion, think before building, fix corrections as classes, failure classes to check, project tooling, changelogs and when to ask",
      "author": {
        "name": "George Lubaretsi",
        "email": "george@lubaretsi.com"
      },
      "homepage": "https://github.com/georgelubaretsi/piebird/tree/main/plugins/piebird-workflow-rules",
      "repository": "https://github.com/georgelubaretsi/piebird",
      "license": "MIT",
      "keywords": [
        "workflow",
        "review",
        "omp"
      ],
      "category": "productivity"
    },
    {
      "name": "piebird-tern-ghostty-style",
      "source": "./plugins/piebird-tern-ghostty-style",
      "version": "0.1.0",
      "description": "omp in Tern, drawn the way omp looks in Ghostty: one box per tool call, thoughts left open, bash as $ command, compact diffs and replies",
      "author": {
        "name": "George Lubaretsi",
        "email": "george@lubaretsi.com"
      },
      "homepage": "https://github.com/georgelubaretsi/piebird/tree/main/plugins/piebird-tern-ghostty-style",
      "repository": "https://github.com/georgelubaretsi/piebird",
      "license": "MIT",
      "keywords": [
        "tern",
        "ghostty",
        "omp",
        "theme"
      ],
      "category": "appearance"
    }
  ]
